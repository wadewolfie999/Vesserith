{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vesserith.xyz/schemas/github-status-snapshot-v1.json",
  "title": "Vesserith derived GitHub status snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "source", "status", "entries"],
  "properties": {
    "schema": {
      "const": "https://vesserith.xyz/schemas/github-status-snapshot-v1.json"
    },
    "generatedAt": {
      "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "source": { "enum": ["checked-in-fallback", "github-api"] },
    "status": { "enum": ["complete", "partial", "unavailable"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "repository",
          "reviewedRevision",
          "observedDefaultBranch",
          "observedDefaultRevision",
          "observedAt",
          "state"
        ],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "format": "uri" },
          "reviewedRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "observedDefaultBranch": {
            "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
          },
          "observedDefaultRevision": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[a-f0-9]{40}$" }
            ]
          },
          "observedAt": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "format": "date-time" }
            ]
          },
          "state": {
            "enum": ["reviewed-match", "revision-changed", "unavailable"]
          }
        }
      }
    }
  }
}
