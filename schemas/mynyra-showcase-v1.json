{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wadewolfie999.github.io/Vesserith/schemas/mynyra-showcase-v1.json",
  "title": "Vesserith Mynyra research-lab exhibit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectId",
    "source",
    "title",
    "summary",
    "mode",
    "pipeline",
    "signals",
    "nextGate",
    "links"
  ],
  "properties": {
    "schema": {
      "const": "https://wadewolfie999.github.io/Vesserith/schemas/mynyra-showcase-v1.json"
    },
    "projectId": { "const": "mynyra" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "reviewedAt"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "mode": { "const": "BACKTEST" },
    "pipeline": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "detail"],
        "properties": {
          "id": { "enum": ["manifest", "replay", "evidence"] },
          "label": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "value", "detail"],
        "properties": {
          "id": { "enum": ["mode", "provider", "orders", "backend"] },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nextGate": { "type": "string", "minLength": 1 },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRecord", "repository", "offlineReplay"],
      "properties": {
        "evidenceRecord": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "offlineReplay": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  }
}
