{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wadewolfie999.github.io/Vesserith/schemas/build-provenance-v1.json",
  "title": "Vesserith public build provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectId",
    "sourceCommit",
    "buildTimestamp",
    "environment",
    "registrySchema",
    "evidenceSchema"
  ],
  "properties": {
    "schema": {
      "const": "https://wadewolfie999.github.io/Vesserith/schemas/build-provenance-v1.json"
    },
    "projectId": { "const": "vesserith" },
    "sourceCommit": {
      "anyOf": [
        { "const": "local-uncommitted" },
        { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      ]
    },
    "buildTimestamp": {
      "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "environment": { "type": "string", "minLength": 1 },
    "registrySchema": { "const": "ecosystem-registry/v1" },
    "evidenceSchema": { "const": "public-evidence/v1" }
  }
}
