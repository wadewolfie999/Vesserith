{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wadewolfie999.github.io/Vesserith/schemas/ecosystem-registry-v1.json",
  "title": "Vesserith ecosystem registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceEpoch", "projects"],
  "properties": {
    "schema": {
      "const": "https://wadewolfie999.github.io/Vesserith/schemas/ecosystem-registry-v1.json"
    },
    "evidenceEpoch": { "type": "string", "format": "date" },
    "projects": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "nullableHttpsUrl": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "uri", "pattern": "^https://" }
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "label"],
      "properties": {
        "state": { "type": "string" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mark",
        "role",
        "summary",
        "implementation",
        "operation",
        "evidence",
        "source",
        "surfaces",
        "boundaries",
        "nextGate",
        "reviewedAt"
      ],
      "properties": {
        "id": {
          "enum": ["vesserith", "mynyra", "hova"]
        },
        "name": { "type": "string", "minLength": 1 },
        "mark": { "type": "string", "minLength": 1, "maxLength": 2 },
        "role": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "implementation": {
          "allOf": [
            { "$ref": "#/$defs/status" },
            {
              "properties": {
                "state": { "enum": ["shell", "prototype", "implemented"] }
              }
            }
          ]
        },
        "operation": {
          "allOf": [
            { "$ref": "#/$defs/status" },
            {
              "properties": {
                "state": {
                  "enum": ["not-deployed", "deferred", "unverified", "verified"]
                }
              }
            }
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "label", "detail"],
          "properties": {
            "state": {
              "enum": [
                "observed",
                "operator-recorded",
                "inferred",
                "unavailable"
              ]
            },
            "label": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision"],
          "properties": {
            "repository": { "$ref": "#/$defs/nullableHttpsUrl" },
            "revision": {
              "anyOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^[a-f0-9]{40}$" }
              ]
            }
          }
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "wiki", "pages"],
          "properties": {
            "repository": { "$ref": "#/$defs/nullableHttpsUrl" },
            "wiki": { "$ref": "#/$defs/nullableHttpsUrl" },
            "pages": { "$ref": "#/$defs/nullableHttpsUrl" }
          }
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "nextGate": { "type": "string", "minLength": 1 },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "status", "detail"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    }
  }
}
