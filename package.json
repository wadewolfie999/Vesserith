{
  "name": "vesserith",
  "version": "3.0.0",
  "private": true,
  "description": "A private learning observatory and personal trail builder",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:artifact": "node scripts/check-artifact.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.1"
  },
  "type": "module"
}
